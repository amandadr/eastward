# Public site origin (no trailing slash). Used for canonical URLs, Open Graph,
# sitemap.xml, robots.txt, and JSON-LD. Set the real production URL in the host
# (e.g. Netlify) and in .env.local — do not commit the live value here.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Set to "false" only on preview / staging hosts. Production should allow indexing.
SITE_INDEXING=true

# Google Maps Embed API (Maps Embed API only). Restrict the key to HTTP referrers
# for localhost and your production domain. Embed requests are not billed; a
# Google Cloud billing account is still required to enable the API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
