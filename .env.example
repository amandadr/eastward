# Public site origin (no trailing slash). Used for canonical URLs, Open Graph,
# sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://eastward.amandadroy.com

# Set to "false" only on preview / staging hosts. Production should allow indexing.
SITE_INDEXING=true

# Google Maps Embed API (Maps Embed API only). Restrict the key to HTTP referrers
# for localhost and https://eastward.amandadroy.com. Embed requests are not billed; a
# Google Cloud billing account is still required to enable the API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
